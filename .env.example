# Copia este archivo como .env.local para desarrollo.
#
# NINGUNA de estas variables es obligatoria para que la app funcione:
# todas tienen un valor por defecto razonable. En Vercel se configuran en
# Project Settings > Environment Variables.

# URL pública del sitio, para los metadatos absolutos (Open Graph).
# En Vercel se detecta sola con VERCEL_PROJECT_PRODUCTION_URL.
# Solo hace falta ponerla cuando haya dominio propio.
# NEXT_PUBLIC_SITE_URL=https://respia-news.vercel.app

# Idioma de los chistes de prueba (es, en, de, fr, pt). Por defecto: es
# Temporal: desaparece cuando entre el servicio real de noticias.
# JOKES_LANG=es
